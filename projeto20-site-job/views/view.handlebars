<div id="job-view-container" class="continer">
    <div class="row text-center">
        <a class="back-link main-color" href="/">Voltar</a>
        <div id="img-container" class="col-md-12">
            <img src="/img/linkedinlogo.png" alt="company">
        </div>
        <div class="col-md-12">
            <h1 class="main-color">{{job.dataValues.title}}</h1>
            <p class="bold">Quem eles estão buscando</p>
            <p class="job-desc">{{job.dataValues.description}}</p>
            <p><span class="bold">Salario informado é de:</span> {{job.dataValues.salary}}</p>
            <p>
                Para trabalha na empresa: <span class="bold main-color"> {{job.dataValues.company}}</span> envie para o email <a class="main-color" href="mail:to{{job.dataValues.email}}">{{job.dataValues.email}}</a>
            </p>
        </div>
    </div>
</div>